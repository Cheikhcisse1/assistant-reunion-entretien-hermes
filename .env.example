# Copie ce fichier en ".env" et colle TES clés (ne les partage jamais).
DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Envoi de mail (bouton "Valider"). Exemple Gmail: smtp.gmail.com + mot de passe d'application
MAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Hermès (Nous Research) en local via Ollama: installer Ollama puis `ollama pull hermes3`
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3

# IA gratuite Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Démo publique sans mot de passe (Gemini imposé, mail serveur désactivé)
PUBLIC_MODE=0
